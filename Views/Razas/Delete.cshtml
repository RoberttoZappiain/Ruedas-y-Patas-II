@model RuedaYPatas.Models.Raza
@{ ViewData["Title"] = "Eliminar Raza"; }

<div class="container mt-4">
    <h1 class="display-4 text-danger">@ViewData["Title"]</h1>
    <h3 class="text-danger">¿Estás seguro de que quieres eliminar esto?</h3><hr />
    <div class="card bg-danger-subtle border-danger shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>
            </dl>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Eliminar Definitivamente</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>