@model RuedaYPatas.Models.Ubicacion

@{
    ViewData["Title"] = "Eliminar Ubicación";
}

<div class="container mt-4">
    <h1 class="display-4 text-danger">@ViewData["Title"]</h1>
    <h3 class="text-danger">¿Estás seguro de que quieres eliminar esto?</h3>
    <hr />
    <div class="card bg-danger-subtle border-danger shadow-sm">
        <div class="card-body">
            <h4>Ubicación</h4>
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Ciudad)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Ciudad)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
            </dl>
    
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Eliminar Definitivamente</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>