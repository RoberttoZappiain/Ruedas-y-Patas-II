@model RuedaYPatas.Models.Hospedaje
@{
    ViewData["Title"] = "Editar Hospedaje";
}

<div class="container mt-4">
    <h1 class="display-4">@ViewData["Title"]</h1>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label"></label>
                            <input asp-for="Titulo" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CostoPorNoche" class="form-label"></label>
                                <input asp-for="CostoPorNoche" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UbicacionId" class="form-label"></label>
                                <select asp-for="UbicacionId" class="form-select" asp-items="ViewBag.UbicacionId"></select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Foto Actual</label>
                            <div>
                                <img src="@(string.IsNullOrEmpty(Model.Foto) ? "/images/default-house.png" : Model.Foto)" class="img-thumbnail" width="150" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Subir Nueva Foto (opcional)</label>
                            <input name="fotoFile" type="file" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex justify-content-start gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}