@model IEnumerable<RuedaYPatas.Models.Mascota>
@{ ViewData["Title"] = "Mis Mascotas"; }

<style>
    .profile-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        text-align: center;
        padding: 2rem 1.5rem;
    }
    .profile-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #0d6efd;
        margin-top: -80px;
        margin-bottom: 1rem;
    }
    .profile-details summary {
        cursor: pointer;
        color: #0d6efd;
        outline: none;
    }
    .profile-details ul {
        list-style: none;
        padding: 0;
        text-align: left;
        margin-top: 1rem;
    }
</style>

<div class="container mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="display-4">@ViewData["Title"]</h1>
        <a class="btn btn-primary btn-lg" asp-action="Create"><i class="fas fa-plus"></i> Registrar Mascota</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Aún no tienes mascotas registradas.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-5">
                    <div class="profile-card">
                        <img src="@(string.IsNullOrEmpty(item.Foto) ? "/images/default-pet.png" : item.Foto)" class="profile-img" alt="Foto de @item.Nombre">
                        
                        <h4 class="mb-0">@item.Nombre</h4>
                        <p class="text-muted">@item.Raza</p>

                        <details class="profile-details">
                            <summary>Ver más...</summary>
                            <ul class="mt-3">
                                <li><strong>Especie:</strong> @item.Especie</li>
                                <li><strong>Edad:</strong> @item.Edad años</li>
                            </ul>
                        </details>
                        
                        <div class="mt-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>