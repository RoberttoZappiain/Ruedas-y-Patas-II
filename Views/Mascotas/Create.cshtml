@model RuedaYPatas.ViewModels.MascotaCreateViewModel

@{
    ViewData["Title"] = "Registrar Nueva Mascota";
}

<div class="container mt-4">
    <h1 class="display-4">@ViewData["Title"]</h1>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Raza" class="form-label"></label>
                                <select asp-for="Raza" class="form-select" asp-items="Model.RazasDisponibles">
                                    <option value="">-- Seleccione una Raza --</option>
                                </select>
                                <span asp-validation-for="Raza" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Especie" class="form-label"></label>
                                <input asp-for="Especie" class="form-control" />
                                <span asp-validation-for="Especie" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Edad" class="form-label"></label>
                                <input asp-for="Edad" type="number" class="form-control" />
                                <span asp-validation-for="Edad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FotoFile" class="form-label"></label>
                            <input asp-for="FotoFile" type="file" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex justify-content-start gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Registrar Mascota</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}