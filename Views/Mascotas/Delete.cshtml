@model RuedaYPatas.Models.Mascota

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="container mt-4">
    <h1 class="display-4 text-danger">@ViewData["Title"]</h1>
    <h3 class="text-danger">¿Estás seguro de que quieres eliminar a @Model.Nombre?</h3>
    <hr />
    <div class="card bg-danger-subtle border-danger shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>
                
                <dt class="col-sm-3">Raza</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Raza)</dd>
            </dl>
    
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Sí, Eliminar Definitivamente</button>
                <a asp-action="Index" class="btn btn-secondary">No, Cancelar</a>
            </form>
        </div>
    </div>
</div>